{
  "engine": "semgrep",
  "seeds": "../seeds_fstring",
  "rules": "../rules/formatted-sql-query.yaml",
  "corpus_kind": "synthetic",
  "attempts": 15,
  "trajectories": 30,
  "base_seed": 6223,
  "strategies": [
    3,
    5
  ],
  "cache": false,
  "scanner_timeout": 120,
  "oracle_timeout": 5,
  "metropolis_temperature": 0.25,
  "rule_metadata": "Semgrep formatted-sql-query: detects f-string, percent or str.format SQL passed directly or via a variable into DB.execute. Use parameterized queries.",
  "llm": {
    "provider": "soclaas",
    "base_url": "https://soclaas-api.comp.nus.edu.sg/v1",
    "model": "qwen3.6:35b",
    "api_key_env": "SOCLAAS_API_KEY",
    "env_file": "../.env",
    "temperature": 0.2,
    "timeout": 180,
    "max_prompt_tokens": 2500
  },
  "target_rules": [
    "formatted-sql-query"
  ],
  "operators": [
    "rename",
    "format_swap",
    "literal_slice",
    "dead_padding",
    "extract_1",
    "char_launder",
    "deep_nest",
    "db_roundtrip",
    "queue_roundtrip"
  ]
}